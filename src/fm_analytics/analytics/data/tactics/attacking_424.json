{
  "key": "attacking_424",
  "name": "Attacking 4-2-4",
  "formation": "4-2-4",
  "mentality": "Attacking",
  "instructions": [
    "Fairly Wide",
    "More Direct Passing",
    "Higher Tempo",
    "Pass Into Space",
    "Counter-Press",
    "Counter",
    "Higher Line of Engagement",
    "Higher Defensive Line"
  ],
  "slots": [
    {
      "key": "GK",
      "position": "GK",
      "role": "sk_defend",
      "why": "Sweeper keeper covers the space behind a high line, which this shape leaves open."
    },
    {
      "key": "DL",
      "position": "DL",
      "role": "fb_support",
      "why": "Support full-back stays reasonably safe, because the wide attackers already supply the width."
    },
    {
      "key": "DCL",
      "position": "DC",
      "role": "cd_defend",
      "roles": [
        "cd_cover"
      ],
      "why": "Central defender marks the striker; with a high line there is little room for error, so pace matters. Cover is the alternate."
    },
    {
      "key": "DCR",
      "position": "DC",
      "role": "cd_cover",
      "roles": [
        "cd_defend"
      ],
      "why": "Cover centre-back sweeps up behind his partner, since runners in behind are the main danger against a line this high."
    },
    {
      "key": "DR",
      "position": "DR",
      "role": "fb_support",
      "why": "Support full-back on the right, holding a safer position while the wide attackers work the flank."
    },
    {
      "key": "MCL",
      "position": "MC",
      "role": "bwm_mc_defend",
      "why": "Ball-Winning Midfielder (Defend) attacks loose balls and supports the counter-press, but retains more defensive discipline in a two-man midfield than the Support duty."
    },
    {
      "key": "MCR",
      "position": "MC",
      "role": "dlp_mc_support",
      "why": "Deep-lying playmaker is the only creative player in the middle and gets the ball to the four forwards quickly."
    },
    {
      "key": "AML",
      "position": "AML",
      "role": "if_attack",
      "why": "Inside forward cuts in from the left to attack the box alongside the strikers."
    },
    {
      "key": "AMR",
      "position": "AMR",
      "role": "winger_aml_amr_attack",
      "why": "Winger stays wide and delivers, stretching the back line for the two strikers."
    },
    {
      "key": "STL",
      "position": "ST",
      "role": "dlf_support",
      "roles": [
        "cf_support"
      ],
      "why": "Deep-lying forward links the two wide players with the other striker, and is the one forward who drops to receive the ball."
    },
    {
      "key": "STR",
      "position": "ST",
      "role": "af_attack",
      "roles": [
        "p_attack"
      ],
      "why": "Advanced Forward runs the channels to stretch the back line. Poacher is the alternate if he is more of a finisher than a runner."
    }
  ],
  "system": {
    "minimums": {
      "width": 3.0,
      "defensiveCover": 6.0,
      "ballProgression": 3.5,
      "runners": 3.0,
      "penetration": 3.5,
      "boxPresence": 2.5,
      "restDefence": 6.5
    },
    "maximumAttackDuties": 6,
    "maximumCreators": 3
  },
  "style": "Attacking 4-2-4",
  "description": "A deliberately high-risk 4-2-4 that commits four players to the front line, presses aggressively after losses and moves the ball forward quickly. It is a forcing tactic rather than a default shape.",
  "whyGood": "The DLF supplies the connection the shape would otherwise lack, the DLP provides central distribution, and the other three attackers provide width, box threat and runs beyond. The BWM gives the exposed two-man midfield a dedicated ball-winner.",
  "whyThisShape": "Four forwards and only two central midfielders: the most one-sided shape in the catalogue. Four attackers pin the opposition back line, and the two midfielders win the ball and feed it forward at once.",
  "whenToUse": "When you need to force the game, particularly when chasing a result or when you can sustain pressure against an opponent whose defensive structure is being overwhelmed.",
  "whenNotToUse": "Against opponents who can play through pressure or exploit space around the two central midfielders and behind the high defensive line. It is too structurally aggressive to serve as a routine season-long default.",
  "instructionRationale": {
    "Fairly Wide": "Stretches the opponent so the four forwards have space to work in.",
    "More Direct Passing": "With only two midfielders, quicker forward passes skip the middle of the pitch entirely.",
    "Higher Tempo": "Gets the ball to the forwards before the defence has set.",
    "Pass Into Space": "Gives the fast forwards balls to run onto behind a high line.",
    "Counter-Press": "Wins the ball back at once so you can attack again while the opponent is still out of shape.",
    "Counter": "Attacks quickly on winning the ball, before the opposition can recover their shape.",
    "Higher Line of Engagement": "Keeps the press high, so the attackers are supported by pressure on the ball.",
    "Higher Defensive Line": "Keeps the team compact so two midfielders have less ground to cover, at the cost of exposing slower defenders."
  },
