{
  "name": "fm-analytics-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:css": "tailwindcss -i ./styles/app.css -o ../src/fm_analytics/web/static/app.css --minify",
    "build:js": "esbuild scripts/app.js --bundle --format=iife --target=es2020 --minify --outfile=../src/fm_analytics/web/static/app.js",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "esbuild": "^0.25.3",
    "tailwindcss": "^3.4.19"
  }
}
